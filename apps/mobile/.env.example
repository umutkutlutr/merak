# Public (bundled into the app) — never put secrets here.
# API base URL. Simulator/web: localhost. Physical device: your machine's LAN IP, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
# Supabase Auth base URL. Local stack: standalone GoTrue. Supabase CLI: http://127.0.0.1:54321/auth/v1
EXPO_PUBLIC_AUTH_URL=http://localhost:9999
# Supabase anon/publishable key (needed only when the Auth URL sits behind Supabase's API gateway). Local GoTrue ignores it.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
