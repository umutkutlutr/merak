{
  "expo": {
    "name": "Merak",
    "slug": "merak",
    "version": "0.0.1",
    "scheme": "merak",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#F6F3EE",
    "splash": { "backgroundColor": "#F6F3EE", "resizeMode": "contain" },
    "ios": { "supportsTablet": false, "bundleIdentifier": "app.merak.m0" },
    "android": { "package": "app.merak.m0", "edgeToEdgeEnabled": true },
    "web": { "bundler": "metro", "output": "single", "favicon": "./assets/favicon.png" },
    "plugins": ["expo-router", "expo-secure-store", "expo-font"],
    "experiments": { "typedRoutes": false }
  }
}
