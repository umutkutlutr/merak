{
  "name": "@merak/api",
  "version": "0.0.1",
  "private": true,
  "description": "Merak API — NestJS modular monolith (auth, content, learning, live quiz authority, admin).",
  "scripts": {
    "prebuild": "pnpm --filter @merak/contracts build",
    "build": "nest build",
    "predev": "pnpm --filter @merak/contracts build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "pnpm run build && node dist/seed/seed.js",
    "pretest": "pnpm --filter @merak/contracts build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "demo:two-users": "pnpm --filter @merak/contracts build && tsx scripts/demo-two-users.ts",
    "demo:web": "pnpm --filter @merak/contracts build && tsx scripts/demo-web-screens.ts"
  },
  "dependencies": {
    "@merak/contracts": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/platform-socket.io": "12.1.3",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "12.1.3",
    "dotenv": "18.0.8",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.12",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.3",
    "@swc/core": "1.16.18",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "pino-pretty": "13.2.0",
    "playwright": "1.64.1",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.4"
  }
}
