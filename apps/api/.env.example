# ---- Merak API (local) ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Comma-separated browser origins allowed for CORS (admin + Expo web)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://127.0.0.1:5173,http://127.0.0.1:8081

# App database role (owns the `app` schema; has no access to `auth`)
DATABASE_URL=postgres://app_api:app_api_local_dev@127.0.0.1:54329/merak
# Superuser / migration role. Used only by `db:migrate`, `db:seed` and tests — never by the running API.
DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:54329/merak

# Supabase Auth (GoTrue). Local stack: standalone GoTrue at :9999.
# With `supabase start` use http://127.0.0.1:54321/auth/v1 and the JWT secret from `supabase status`.
SUPABASE_AUTH_URL=http://localhost:9999
# HS256 verification (local / Supabase CLI). Leave empty when using SUPABASE_JWKS_URL.
SUPABASE_JWT_SECRET=merak-local-dev-jwt-secret-do-not-use-in-prod-0123456789
# Asymmetric verification (hosted Supabase): e.g. https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# Expected claims
AUTH_JWT_ISSUER=http://localhost:9999
AUTH_JWT_AUDIENCE=authenticated
# Service-role key for seeding users via the Auth admin API. Local stack: leave empty, it is minted from SUPABASE_JWT_SECRET.
SUPABASE_SERVICE_ROLE_KEY=

# Live quiz scheduler
QUIZ_SCHEDULER_ENABLED=true
QUIZ_SCHEDULER_TICK_MS=250
# Seeded admin/test accounts (local only; seed refuses to run when NODE_ENV=production)
SEED_PASSWORD=Merak-Local-123
